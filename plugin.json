{
	"id": "nodebb-plugin-altcha",
	"library": "./library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:register.build", "method": "onRegisterBuild" },
		{ "hook": "filter:login.build", "method": "onLoginBuild" },
		{ "hook": "filter:reset.build", "method": "onResetBuild" },
		{ "hook": "filter:register.check", "method": "checkRegistration" },
		{ "hook": "filter:login.check", "method": "checkLogin" },
		{ "hook": "action:settings.set", "method": "onSettingsSet" }
	],
	"scripts": ["static/lib/client.js"],
	"modules": {
		"../admin/plugins/altcha.js": "static/lib/admin.js"
	},
	"templates": "templates",
	"languages": "languages"
}
